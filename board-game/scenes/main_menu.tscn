[node name="Heading" type="Label" parent="HelpView/HelpPanel/MarginContainer/HelpContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.87, 0.73, 1)
theme_override_font_sizes/font_size = 28
text = "How to Play"
horizontal_alignment = 1

[node name="Instructions" type="Label" parent="HelpView/HelpPanel/MarginContainer/HelpContent"]
custom_minimum_size = Vector2(600, 0)
layout_mode = 2
text = "Click a gold entrance in your current room to reveal another room.\nClick your character to select it, then click a connected room to move.\nDrag the board to pan; use the mouse wheel to zoom.\nEnter a room and click an item to collect it. Click an inventory card to inspect it, then choose Use.\nLaudanum heals 25% health when you are below full health. A pit can be hidden in any revealed room; the next token to enter that room can no longer move."
autowrap_mode = 2

[node name="BackButton" type="Button" parent="HelpView/HelpPanel/MarginContainer/HelpContent"]
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
text = "Back"
