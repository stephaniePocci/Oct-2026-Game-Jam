[node name="HelpView" type="CenterContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="HelpPanel" type="PanelContainer" parent="HelpView"]
custom_minimum_size = Vector2(680, 0)
